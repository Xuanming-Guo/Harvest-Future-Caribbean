{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harvest domain event envelope",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "simulationRunId",
    "actorId",
    "entityId",
    "traceId",
    "correlationId",
    "causationId",
    "schemaVersion",
    "provenance",
    "payload"
  ],
  "properties": {
    "eventId": { "$ref": "../common.schema.json#/$defs/Uuid" },
    "eventType": {
      "type": "string",
      "enum": [
        "CROP_OBSERVATION_SUBMITTED",
        "VERIFICATION_TASK_CREATED",
        "VERIFICATION_DECIDED",
        "FORECAST_PRODUCED",
        "LISTING_PUBLISHED",
        "BUYER_DEMAND_CREATED",
        "ORDER_REQUESTED",
        "ALLOCATION_PROPOSED",
        "ALLOCATION_APPROVED",
        "DELIVERY_MISSION_CREATED",
        "DELIVERY_MISSION_ACCEPTED",
        "DELIVERY_UPDATE_POSTED",
        "EXCEPTION_REPORTED",
        "RECOVERY_APPROVED",
        "DELIVERY_ACCEPTED",
        "ORDER_FULFILLED",
        "ORDER_PARTIALLY_FULFILLED",
        "ORDER_REJECTED",
        "ORDER_CANCELLED",
        "SIMULATION_ACTOR_MOVED",
        "SIMULATION_DISRUPTION_OBSERVED",
        "SIMULATION_TASK_COMPLETED",
        "BENCHMARK_RESULT_RECORDED"
      ]
    },
    "occurredAt": { "$ref": "../common.schema.json#/$defs/UtcDateTime" },
    "simulationTime": { "$ref": "../common.schema.json#/$defs/SimulationTime" },
    "simulationRunId": {
      "oneOf": [
        { "$ref": "../common.schema.json#/$defs/Uuid" },
        { "type": "null" }
      ],
      "description": "Null for real-world activity; required as a field so consumers make the distinction explicit."
    },
    "actorId": { "$ref": "../common.schema.json#/$defs/Uuid" },
    "entityId": { "$ref": "../common.schema.json#/$defs/Uuid" },
    "traceId": { "$ref": "../common.schema.json#/$defs/Uuid" },
    "correlationId": { "$ref": "../common.schema.json#/$defs/Uuid" },
    "causationId": {
      "oneOf": [
        { "$ref": "../common.schema.json#/$defs/Uuid" },
        { "type": "null" }
      ]
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "examples": ["1.0"]
    },
    "provenance": { "$ref": "../common.schema.json#/$defs/Provenance" },
    "payload": {
      "oneOf": [
        { "$ref": "#/$defs/CropObservationSubmittedPayload" },
        { "$ref": "#/$defs/VerificationPayload" },
        { "$ref": "#/$defs/ForecastProducedPayload" },
        { "$ref": "#/$defs/ListingPublishedPayload" },
        { "$ref": "#/$defs/BuyerDemandCreatedPayload" },
        { "$ref": "#/$defs/OrderRequestedPayload" },
        { "$ref": "#/$defs/AllocationPayload" },
        { "$ref": "#/$defs/DeliveryMissionPayload" },
        { "$ref": "#/$defs/DeliveryUpdatePayload" },
        { "$ref": "#/$defs/ExceptionPayload" },
        { "$ref": "#/$defs/RecoveryPayload" },
        { "$ref": "#/$defs/DeliveryAcceptedPayload" },
        { "$ref": "#/$defs/OrderOutcomePayload" },
        { "$ref": "#/$defs/SimulationActorMovedPayload" },
        { "$ref": "#/$defs/SimulationDisruptionPayload" },
        { "$ref": "#/$defs/SimulationTaskPayload" },
        { "$ref": "#/$defs/BenchmarkResultPayload" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "eventType": { "const": "CROP_OBSERVATION_SUBMITTED" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/CropObservationSubmittedPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "enum": ["VERIFICATION_TASK_CREATED", "VERIFICATION_DECIDED"] } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/VerificationPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "FORECAST_PRODUCED" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/ForecastProducedPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "LISTING_PUBLISHED" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/ListingPublishedPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "BUYER_DEMAND_CREATED" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/BuyerDemandCreatedPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "ORDER_REQUESTED" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/OrderRequestedPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "enum": ["ALLOCATION_PROPOSED", "ALLOCATION_APPROVED"] } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/AllocationPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "DELIVERY_MISSION_CREATED" } } },
      "then": {
        "properties": {
          "payload": {
            "allOf": [
              { "$ref": "#/$defs/DeliveryMissionPayload" },
              { "properties": { "status": { "const": "AVAILABLE" } } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "DELIVERY_MISSION_ACCEPTED" } } },
      "then": {
        "properties": {
          "payload": {
            "allOf": [
              { "$ref": "#/$defs/DeliveryMissionPayload" },
              { "properties": { "status": { "const": "ASSIGNED" } } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "DELIVERY_UPDATE_POSTED" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/DeliveryUpdatePayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "EXCEPTION_REPORTED" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/ExceptionPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "RECOVERY_APPROVED" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/RecoveryPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "DELIVERY_ACCEPTED" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/DeliveryAcceptedPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "ORDER_FULFILLED" } } },
      "then": { "properties": { "payload": { "allOf": [{ "$ref": "#/$defs/OrderOutcomePayload" }, { "properties": { "status": { "const": "FULFILLED" } } }] } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "ORDER_PARTIALLY_FULFILLED" } } },
      "then": { "properties": { "payload": { "allOf": [{ "$ref": "#/$defs/OrderOutcomePayload" }, { "properties": { "status": { "const": "PARTIALLY_FULFILLED" } } }] } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "ORDER_REJECTED" } } },
      "then": { "properties": { "payload": { "allOf": [{ "$ref": "#/$defs/OrderOutcomePayload" }, { "properties": { "status": { "const": "REJECTED" } } }] } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "ORDER_CANCELLED" } } },
      "then": { "properties": { "payload": { "allOf": [{ "$ref": "#/$defs/OrderOutcomePayload" }, { "properties": { "status": { "const": "CANCELLED" } } }] } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "SIMULATION_ACTOR_MOVED" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/SimulationActorMovedPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "SIMULATION_DISRUPTION_OBSERVED" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/SimulationDisruptionPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "SIMULATION_TASK_COMPLETED" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/SimulationTaskPayload" } } }
    },
    {
      "if": { "properties": { "eventType": { "const": "BENCHMARK_RESULT_RECORDED" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/BenchmarkResultPayload" } } }
    }
  ],
  "$defs": {
    "CropObservationSubmittedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationId", "cropBatchId", "observedAt", "cropStage"],
      "properties": {
        "observationId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "cropBatchId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "observedAt": { "$ref": "../common.schema.json#/$defs/UtcDateTime" },
        "cropStage": { "type": "string", "minLength": 1 }
      }
    },
    "VerificationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "cropBatchId", "observationId", "status"],
      "properties": {
        "taskId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "cropBatchId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "observationId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "status": { "enum": ["OPEN", "VERIFIED", "CHANGES_REQUESTED"] },
        "note": { "type": "string", "maxLength": 1000 }
      }
    },
    "ForecastProducedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predictionId", "cropBatchId", "q10MarketableYield", "availableToPromise"],
      "properties": {
        "predictionId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "cropBatchId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "q10MarketableYield": { "$ref": "../common.schema.json#/$defs/Quantity" },
        "availableToPromise": { "$ref": "../common.schema.json#/$defs/Quantity" }
      }
    },
    "ListingPublishedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listingId", "cropBatchId", "quantity", "availableFrom"],
      "properties": {
        "listingId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "cropBatchId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "quantity": { "$ref": "../common.schema.json#/$defs/Quantity" },
        "availableFrom": { "type": "string", "format": "date" }
      }
    },
    "BuyerDemandCreatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demandId", "cropType", "quantity", "neededBy"],
      "properties": {
        "demandId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "cropType": { "type": "string", "minLength": 1 },
        "quantity": { "$ref": "../common.schema.json#/$defs/Quantity" },
        "neededBy": { "$ref": "../common.schema.json#/$defs/UtcDateTime" }
      }
    },
    "OrderRequestedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderId", "cropType", "requestedQuantity", "status"],
      "properties": {
        "orderId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "cropType": { "type": "string", "minLength": 1 },
        "requestedQuantity": { "$ref": "../common.schema.json#/$defs/Quantity" },
        "status": { "const": "REQUESTED" }
      }
    },
    "AllocationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allocationId", "orderId", "lines"],
      "properties": {
        "allocationId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "orderId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cropBatchId", "quantity"],
            "properties": {
              "cropBatchId": { "$ref": "../common.schema.json#/$defs/Uuid" },
              "quantity": { "$ref": "../common.schema.json#/$defs/Quantity" }
            }
          }
        }
      }
    },
    "DeliveryMissionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missionId", "orderId", "status", "stops"],
      "properties": {
        "missionId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "orderId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "status": { "enum": ["AVAILABLE", "ASSIGNED"] },
        "transporterId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "stops": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "../common.schema.json#/$defs/GeoPoint" }
        }
      }
    },
    "DeliveryUpdatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missionId", "updateType", "recordedAt"],
      "properties": {
        "missionId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "updateType": { "enum": ["PICKED_UP", "POSITION", "DELAYED", "ARRIVED", "DELIVERED"] },
        "recordedAt": { "$ref": "../common.schema.json#/$defs/UtcDateTime" },
        "position": { "$ref": "../common.schema.json#/$defs/GeoPoint" },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "ExceptionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exceptionId", "exceptionType", "severity", "affectedEntityIds"],
      "properties": {
        "exceptionId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "exceptionType": { "enum": ["SHORTFALL", "DELAY", "QUALITY", "VEHICLE", "WEATHER", "OTHER"] },
        "severity": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "affectedEntityIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "../common.schema.json#/$defs/Uuid" }
        }
      }
    },
    "RecoveryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exceptionId", "approvalId", "actionType"],
      "properties": {
        "exceptionId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "approvalId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "actionType": { "enum": ["REALLOCATE", "REROUTE", "RESCHEDULE", "SUBSTITUTE", "CANCEL"] },
        "missionId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "deadline": { "$ref": "../common.schema.json#/$defs/UtcDateTime" }
      }
    },
    "DeliveryAcceptedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliveryId", "orderId", "acceptedQuantity", "rejectedQuantity", "lineOutcomes", "outcome"],
      "properties": {
        "deliveryId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "orderId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "acceptedQuantity": { "$ref": "../common.schema.json#/$defs/Quantity" },
        "rejectedQuantity": { "$ref": "../common.schema.json#/$defs/Quantity" },
        "outcome": { "enum": ["ACCEPTED", "PARTIALLY_ACCEPTED", "REJECTED"] },
        "lineOutcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cropBatchId", "acceptedQuantity", "rejectedQuantity"],
            "properties": {
              "cropBatchId": { "$ref": "../common.schema.json#/$defs/Uuid" },
              "acceptedQuantity": { "$ref": "../common.schema.json#/$defs/Quantity" },
              "rejectedQuantity": { "$ref": "../common.schema.json#/$defs/Quantity" }
            }
          }
        }
      }
    },
    "OrderOutcomePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderId", "status", "acceptedQuantity", "releasedReservationQuantity"],
      "properties": {
        "orderId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "status": { "enum": ["FULFILLED", "PARTIALLY_FULFILLED", "REJECTED", "CANCELLED"] },
        "acceptedQuantity": { "$ref": "../common.schema.json#/$defs/Quantity" },
        "releasedReservationQuantity": { "$ref": "../common.schema.json#/$defs/Quantity" }
      }
    },
    "SimulationActorMovedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "position"],
      "properties": {
        "actorId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "position": { "$ref": "../common.schema.json#/$defs/GeoPoint" }
      }
    },
    "SimulationDisruptionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disruptionType", "affectedEntityIds", "observedAt"],
      "properties": {
        "disruptionType": { "enum": ["WEATHER", "ROAD", "VEHICLE", "CROP", "OTHER"] },
        "affectedEntityIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "../common.schema.json#/$defs/Uuid" }
        },
        "observedAt": { "$ref": "../common.schema.json#/$defs/SimulationTime" },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "SimulationTaskPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "taskType", "actorId", "completedAt"],
      "properties": {
        "taskId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "taskType": { "enum": ["OBSERVE", "APPROVE", "HARVEST", "PICKUP", "DELIVER", "BUY"] },
        "actorId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "completedAt": { "$ref": "../common.schema.json#/$defs/SimulationTime" }
      }
    },
    "BenchmarkResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairId", "baselineRunId", "harvestRunId", "metrics"],
      "properties": {
        "pairId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "baselineRunId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "harvestRunId": { "$ref": "../common.schema.json#/$defs/Uuid" },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["localProcurementRate", "fulfilmentRate", "wasteQuantity"],
          "properties": {
            "localProcurementRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "fulfilmentRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "wasteQuantity": { "$ref": "../common.schema.json#/$defs/Quantity" }
          }
        }
      }
    }
  },
