# Shared local defaults. Copy only the values you need into your shell or a
# workspace-local .env file; never commit real credentials.
DATABASE_URL=postgresql://harvest:harvest-local-only@localhost:5432/harvest?schema=public
PRODUCT_API_PORT=3001
NEXT_PUBLIC_PRODUCT_API_URL=http://localhost:3001
DEV_JWT_SECRET=harvest-local-development-secret-change-me
INTERNAL_SERVICE_TOKEN=harvest-local-service-token-change-me
MODEL_ADAPTER=fixture
SIMULATION_ADAPTER=fixture

# Agent text assistance is provider-neutral. Leave these blank to use the
# deterministic local fixture. See docs/agent_workflows.md before adding a
# provider adapter, and never commit a real API key.
AGENT_LLM_PROVIDER=
AGENT_LLM_MODEL=
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
