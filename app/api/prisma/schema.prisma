generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActorRole {
  FARMER
  BUYER
  TRANSPORTER
  COORDINATOR
  OPERATIONS
  ADMIN
}

enum Provenance {
  OBSERVED
  INFERRED
  SYNTHETIC
  STAKEHOLDER_CALIBRATED
  MODEL_PREDICTED
}

model Actor {
  id            String    @id @db.Uuid
  authSubject   String    @unique @map("auth_subject")
  name          String
  role          ActorRole
  isSynthetic   Boolean   @default(false) @map("is_synthetic")
  defaultLatitude  Float? @map("default_latitude")
  defaultLongitude Float? @map("default_longitude")
  serviceZone      String? @map("service_zone")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("actors")
}

model Farm {
  id          String   @id @db.Uuid
  name        String
  farmerId    String   @map("farmer_id") @db.Uuid
  latitude    Float
  longitude   Float
  productionZone String @default("Saint Lucia") @map("production_zone")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("farms")
}

model FarmPermission {
  id        String    @id @default(uuid()) @db.Uuid
  farmId    String    @map("farm_id") @db.Uuid
  actorId   String    @map("actor_id") @db.Uuid
  role      ActorRole

  @@unique([farmId, actorId])
  @@map("farm_permissions")
}

model CropBatch {
  id                    String     @id @db.Uuid
  farmId                String     @map("farm_id") @db.Uuid
  cropType              String     @map("crop_type")
  status                String
  availableToPromise    Float      @default(0) @map("available_to_promise")
  provenance            Provenance
  latestObservationId   String?    @map("latest_observation_id") @db.Uuid
  latestPredictionId    String?    @map("latest_prediction_id") @db.Uuid
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("crop_batches")
}

model CropObservation {
  id                String     @id @db.Uuid
  cropBatchId       String     @map("crop_batch_id") @db.Uuid
  actorId           String     @map("actor_id") @db.Uuid
  observedAt        DateTime   @map("observed_at") @db.Timestamptz(3)
  recordedAt        DateTime   @default(now()) @map("recorded_at") @db.Timestamptz(3)
  cropStage         String     @map("crop_stage")
  notes             String?
  estimatedQuantity Float?     @map("estimated_quantity")
  provenance        Provenance
  traceId           String     @map("trace_id") @db.Uuid

  @@map("crop_observations")
}

model VerificationTask {
  id          String   @id @db.Uuid
  farmId      String   @map("farm_id") @db.Uuid
  cropBatchId String   @map("crop_batch_id") @db.Uuid
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id") @db.Uuid
  taskType    String   @map("task_type")
  status      String
  summary     String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedBy  String?  @map("resolved_by") @db.Uuid
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(3)
  note        String?

  @@index([farmId, status])
  @@index([cropBatchId, createdAt])
  @@map("verification_tasks")
}

model YieldPrediction {
  id             String     @id @db.Uuid
  requestId      String     @map("request_id") @db.Uuid
  cropBatchId    String     @map("crop_batch_id") @db.Uuid
  modelVersion   String     @map("model_version")
  q10            Float
  q50            Float
  q90            Float
  harvestStart   DateTime   @map("harvest_start") @db.Date
  harvestEnd     DateTime   @map("harvest_end") @db.Date
  readiness      Float
  confidence     Float
  warnings       Json
  featureSnapshot Json      @map("feature_snapshot")
  provenance     Provenance @default(MODEL_PREDICTED)
  generatedAt    DateTime   @map("generated_at") @db.Timestamptz(3)
  actualQuantity Float?     @map("actual_quantity")
  absoluteError  Float?     @map("absolute_error")

  @@map("yield_predictions")
}

model Listing {
  id             String   @id @db.Uuid
  cropBatchId    String   @map("crop_batch_id") @db.Uuid
  farmerId       String   @map("farmer_id") @db.Uuid
  cropType       String   @map("crop_type")
  quantity       Float
  unitPrice      Float    @map("unit_price")
  currency       String   @default("XCD")
  availableFrom  DateTime @map("available_from") @db.Date
  availableUntil DateTime @map("available_until") @db.Date
  status         String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("listings")
}

model BuyerDemand {
  id             String   @id @db.Uuid
  buyerId        String   @map("buyer_id") @db.Uuid
  cropType       String   @map("crop_type")
  quantity       Float
  neededBy       DateTime @map("needed_by") @db.Timestamptz(3)
  latitude       Float
  longitude      Float
  maxUnitPrice   Float?   @map("max_unit_price")
  currency       String?  @default("XCD")
  status         String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("buyer_demands")
}

model Order {
  id                 String   @id @db.Uuid
  buyerId            String   @map("buyer_id") @db.Uuid
  cropType           String   @map("crop_type")
  requestedQuantity  Float    @map("requested_quantity")
  acceptedQuantity   Float    @default(0) @map("accepted_quantity")
  neededBy           DateTime @map("needed_by") @db.Timestamptz(3)
  latitude           Float
  longitude          Float
  listingIds         Json     @map("listing_ids")
  lifecycleStatus    String   @map("lifecycle_status")
  atRisk             Boolean  @default(false) @map("at_risk")
  activeExceptionIds Json     @map("active_exception_ids")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("orders")
}

model Allocation {
  id        String   @id @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  status    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("allocations")
}

model AllocationLine {
  id            String @id @default(uuid()) @db.Uuid
  allocationId  String @map("allocation_id") @db.Uuid
  cropBatchId   String @map("crop_batch_id") @db.Uuid
  listingId     String @map("listing_id") @db.Uuid
  quantity      Float

  @@map("allocation_lines")
}

model Reservation {
  id           String   @id @default(uuid()) @db.Uuid
  allocationId String   @map("allocation_id") @db.Uuid
  cropBatchId  String   @map("crop_batch_id") @db.Uuid
  quantity     Float
  status       String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("reservations")
}

model Approval {
  id          String    @id @db.Uuid
  subjectType String    @map("subject_type")
  subjectId   String    @map("subject_id") @db.Uuid
  requestedFromActorId String @map("requested_from_actor_id") @db.Uuid
  status      String
  requestedAt DateTime  @map("requested_at") @db.Timestamptz(3)
  decidedBy   String?   @map("decided_by") @db.Uuid
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(3)
  reason      String?

  @@map("approvals")
}

model DeliveryMission {
  id            String   @id @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  status        String
  transporterId String?  @map("transporter_id") @db.Uuid
  vehicleId     String?  @map("vehicle_id") @db.Uuid
  quantity      Float
  deadline      DateTime @db.Timestamptz(3)
  stops         Json
  currentStopSequence Int @default(0) @map("current_stop_sequence")

  @@map("delivery_missions")
}

model DeliveryUpdate {
  id         String   @id @db.Uuid
  missionId  String   @map("mission_id") @db.Uuid
  updateType String   @map("update_type")
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(3)
  position   Json?
  quantity   Float?
  note       String?
  stopSequence Int?    @map("stop_sequence")

  @@map("delivery_updates")
}

model OperationalException {
  id                String     @id @db.Uuid
  exceptionType     String     @map("exception_type")
  severity          String
  affectedEntityIds Json       @map("affected_entity_ids")
  description       String
  status            String
  provenance        Provenance
  reportedAt        DateTime   @map("reported_at") @db.Timestamptz(3)
  recoveryAction    String?    @map("recovery_action")
  recoverySummary   String?    @map("recovery_summary")
  recoveryChanges   Json?      @map("recovery_changes")

  @@map("operational_exceptions")
}

model DeliveryAcceptance {
  id               String   @id @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  outcome          String
  acceptedQuantity Float    @map("accepted_quantity")
  rejectedQuantity Float    @map("rejected_quantity")
  note             String?
  acceptedBy       String   @map("accepted_by") @db.Uuid
  acceptedAt       DateTime @map("accepted_at") @db.Timestamptz(3)
  lineOutcomes     Json     @map("line_outcomes")

  @@unique([orderId])
  @@map("delivery_acceptances")
}

model Vehicle {
  id                 String   @id @db.Uuid
  transporterId      String   @map("transporter_id") @db.Uuid
  label              String
  registrationNumber String?  @map("registration_number")
  capacityKg         Float?   @map("capacity_kg")
  status             String
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([transporterId, status])
  @@map("vehicles")
}

model AgentTrace {
  id          String   @id @db.Uuid
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id") @db.Uuid
  status      String
  summary     String

  @@map("agent_traces")
}

model TraceStep {
  id         String   @id @default(uuid()) @db.Uuid
  traceId    String   @map("trace_id") @db.Uuid
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(3)
  kind       String
  summary    String
  confidence Float?

  @@map("trace_steps")
}

model DomainEvent {
  cursor          BigInt     @unique @default(autoincrement())
  id              String     @id @db.Uuid
  eventType       String     @map("event_type")
  occurredAt      DateTime   @map("occurred_at") @db.Timestamptz(3)
  simulationTime  DateTime?  @map("simulation_time") @db.Timestamptz(3)
  simulationRunId String?    @map("simulation_run_id") @db.Uuid
  actorId         String     @map("actor_id") @db.Uuid
  entityId        String     @map("entity_id") @db.Uuid
  traceId         String     @map("trace_id") @db.Uuid
  correlationId   String     @map("correlation_id") @db.Uuid
  causationId     String?    @map("causation_id") @db.Uuid
  schemaVersion   String     @default("1.0") @map("schema_version")
  provenance      Provenance
  payload         Json

  @@index([cursor])
  @@map("domain_events")
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  method       String
  path         String
  key          String
  requestHash  String   @map("request_hash")
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([actorId, method, path, key])
  @@map("idempotency_records")
}
