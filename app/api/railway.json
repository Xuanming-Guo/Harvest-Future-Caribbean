{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci --include=dev && npm run contracts:generate && npm run db:generate && npm run build --workspace @harvest/api"
  },
  "deploy": {
    "startCommand": "npm run start --workspace @harvest/api",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
